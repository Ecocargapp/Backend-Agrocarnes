# Servidor / entorno
PORT=4001
NODE_ENV=production

# PostgreSQL — base de datos PROPIA de Agrocarnes, separada de la de AgroSoft
PGHOST=localhost
PGPORT=5432
PGDATABASE=agrocarnes
PGUSER=agrocarnes_app
PGPASSWORD=cambia-esto

# Auth
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# CORS — dominios desde donde el frontend puede llamar la API
CORS_ORIGIN=https://agrocarnes.agrofranpabel.com
